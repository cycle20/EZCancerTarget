# syntax=docker/dockerfile:1
#
# scancer / EZCancerTarget DEVELOPMENT image (RStudio Server IDE)
#
# Self-contained development environment: R 4.6.1 + the project's package
# library + the RStudio Server web IDE on port 8787. Restores the SAME
# renv.lock as the slim runtime image (Dockerfile), so this environment
# reproduces the runtime environment package-for-package.
#
# For running the pipeline or unit tests in CI/production, use the slim
# runtime image (see ./Dockerfile) instead.
FROM rocker/tidyverse:4.6.1

# System libraries required by the renv packages that are not already provided
# by the tidyverse base image.
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        libssl-dev \
        libcurl4-openssl-dev \
        libxml2-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Remove the Go-built esbuild bundled with Quarto (CVE-2025-68121). Neither the
# pipeline nor the tests use Quarto; this only affects interactive Quarto
# document rendering, which this project does not do.
RUN rm -rf /usr/lib/rstudio-server/bin/quarto/bin/tools/*/esbuild

WORKDIR /app

# renv environment configuration (declared before restore so it takes effect).
ENV HOME=/home/rstudio \
    RENV_PATHS_LIBRARY=/home/rstudio/renv-library \
    RENV_PATHS_CACHE=/home/rstudio/.cache/R/renv/cache \
    RENV_CONFIG_CACHE_ENABLED=TRUE \
    RENV_CONFIG_PAK_ENABLED=FALSE

# Restore the R package library from the lockfile. Copy only the files needed
# for restore first so this layer is cached independently of the source code.
COPY --chown=rstudio:rstudio renv.lock renv.lock
COPY --chown=rstudio:rstudio renv/ renv/
COPY --chown=rstudio:rstudio .Rprofile .Rprofile
RUN chown rstudio:rstudio /app

USER rstudio

RUN R -e "install.packages('renv', repos = 'https://packagemanager.posit.co/cran/latest')" \
    && R -e "renv::consent(provided = TRUE)" \
    && R -e "renv::restore()"

# Copy the rest of the project source.
COPY --chown=rstudio:rstudio . .

# RStudio Server is started via the base image's /init entrypoint on port 8787.
USER root
